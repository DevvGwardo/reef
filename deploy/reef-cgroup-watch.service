# Re-delegates reef.slice to the reef container (uid 1000) on every (re)start of
# the reef-host compose service — closing the gap where a `docker compose up -d`
# recreate would otherwise drop per-capsule cgroup isolation until the next boot.
# Replaces the boot-only reef-cgroup-delegate.service oneshot.
#
# Required only for the docker-compose path on a host using Docker's systemd
# cgroup driver (see deploy/reef-cgroup-delegate.sh + deploy/HARDENING.md §2).
#
# Install:
#   cp deploy/reef-cgroup-delegate.sh deploy/reef-cgroup-watch.sh /usr/local/sbin/
#   chmod +x /usr/local/sbin/reef-cgroup-delegate.sh /usr/local/sbin/reef-cgroup-watch.sh
#   cp deploy/reef-cgroup-watch.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now reef-cgroup-watch.service
[Unit]
Description=Re-delegate reef.slice to the reef container on every (re)start
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/reef-cgroup-watch.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
